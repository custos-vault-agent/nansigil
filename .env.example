PORT=3001
# Signs attestations. Must equal NanSigil.attestor() on-chain.
ATTESTOR_PRIVATE_KEY=

# Nansen Profiler. Empty = fixture client (fixtures/nansen.json), for local demos.
NANSEN_API_KEY=
# Chain slug for Profiler queries: all, ethereum, base, monad, ...
NANSEN_CHAIN=all
#NANSEN_FIXTURE=fixtures/nansen.json
# Reuse a wallet's Nansen profile for this long before re-querying (credits).
#PROFILE_TTL_MS=600000
# PnL window the Profiler query asks for, in days. The API requires a range.
#PNL_WINDOW_DAYS=365
