PORT=3001
# Signs attestations. Must equal NanSigil.attestor() on-chain.
ATTESTOR_PRIVATE_KEY=

# Nansen Profiler. Empty = fixture only (fixtures/nansen.json), for local demos.
# With a key, a wallet that the fixture holds is still answered from the fixture
# and every other wallet from Nansen. Delete or rename the fixture file for a
# Nansen-only service.
NANSEN_API_KEY=
# Chain slug for Profiler queries: all, ethereum, base, monad, ...
NANSEN_CHAIN=all
#NANSEN_FIXTURE=fixtures/nansen.json
# Reuse a wallet's Nansen profile for this long before re-querying (credits).
#PROFILE_TTL_MS=600000
# PnL window the Profiler query asks for, in days. The API requires a range.
#PNL_WINDOW_DAYS=365

# Access-Control-Allow-Origin for the browser. The frontend calls this service
# directly. Payloads are public and signed, so "*" is the default; pin it to the
# site's origin (https://…) to keep other pages from spending your Nansen credits.
#CORS_ORIGIN=*

# Redis or Valkey for the profile cache and the rate limiter, shared by every
# instance and kept over a restart. Empty = in-memory, which is fine for one
# instance. The service keeps working when the server is unreachable; it falls
# back to memory and spends more Nansen credits.
# With a password: redis://default:PASSWORD@host:6379 (or redis://:PASSWORD@host:6379,
# which uses the default user). Percent-encode a password that contains @ : / or #.
#REDIS_URL=redis://localhost:6379

# Attestation requests one client may send per window. /health is not limited.
#RATE_LIMIT=30
#RATE_LIMIT_WINDOW_S=60
# Read the client address from X-Forwarded-For. Set this only behind a proxy you
# control, because a client can put anything in that header.
#TRUST_PROXY=false
